      "when": {
        "facing": "north",
        "blocked": "false"
      },
      "apply": {
        "model": "experience_storage:block/xp_valve_open"
      }
    },
    {
      "when": {
        "facing": "north",
        "blocked": "true"
      },
      "apply": {
        "model": "experience_storage:block/xp_valve_closed"
      }
    },
    {
      "when": {
        "facing": "east",
        "blocked": "false"
      },
      "apply": {
        "model": "experience_storage:block/xp_valve_open",
